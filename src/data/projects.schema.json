{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "个人主页项目清单",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "number", "tone", "kicker", "name", "englishName", "stage", "role", "description", "proofs", "tech", "image", "imageAlt", "entryUrl", "entryLabel"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "number": { "type": "string", "pattern": "^[0-9]{2}$" },
      "tone": { "enum": ["forest", "blue", "green"] },
      "kicker": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "englishName": { "type": "string", "minLength": 1 },
      "stage": { "type": "string", "minLength": 1 },
      "role": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "proofs": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "text"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      },
      "tech": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "image": { "type": "string", "pattern": "^\\./assets/" },
      "imageAlt": { "type": "string", "minLength": 1 },
      "entryUrl": { "type": "string", "pattern": "^https://" },
      "entryLabel": { "type": "string", "minLength": 1 },
      "secondaryUrl": { "type": "string", "pattern": "^\\./" },
      "secondaryLabel": { "type": "string", "minLength": 1 }
    }
  }
}
